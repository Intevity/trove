{
  "name": "trove",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform tray app that auto-detects AI coding harnesses, patches their telemetry config, and forwards a unified OTLP stream to the user's chosen observability backend.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:app": "node scripts/build-app.mjs",
    "build:app:release": "pnpm -F app tauri build",
    "install:app": "node scripts/build-app.mjs",
    "build:collector": "bash scripts/build-collector.sh",
    "bundle:sidecar": "jiti scripts/bundle-sidecar.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jiti": "^2.4.2",
    "lefthook": "^1.10.10",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
