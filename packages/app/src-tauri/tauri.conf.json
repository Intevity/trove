{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "identifier": "com.intevity.trove",
  "version": "0.5.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @trove/shared run build && pnpm --filter @trove/app run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trove",
        "width": 700,
        "height": 500,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/Intevity/trove/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/trove-otelcol"],
    "resources": {
      "../../../resources/hooks/cursor-otel-hook.cjs": "resources/hooks/cursor-otel-hook.cjs",
      "../../../resources/wrappers/trove-aider": "resources/wrappers/trove-aider",
      "../../../resources/wrappers/trove-copilot": "resources/wrappers/trove-copilot"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    }
  }
}
