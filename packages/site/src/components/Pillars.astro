---
// Pillar deep-dives: the marketing narrative for the four audiences Trove sells
// to (engineering leads, finance/ops, security/IT, and the native-vs-best-effort
// coverage story), each broken into its sub-features. Static (no React). Each
// clip in the media rail renders an autoplaying muted/looped <video> (mp4 with a
// webm companion, derived from the clip slug) when hasVideo is true, and falls
// back to a poster placeholder with a "Demo coming soon" affordance when it is
// false. The section uses the shared section-aurora ambient glow.
import Icon from './Icon.astro';
import { pillars } from '../data/pillars';

const base = import.meta.env.BASE_URL;
// Astro's BASE_URL carries a trailing slash; join without doubling it.
const asset = (p: string) => `${base.replace(/\/$/, '')}/videos/${p.replace(/^\//, '')}`;
---

<section id="how-it-works" class="has-aurora">
  <span class="section-aurora" aria-hidden="true"></span>

  <div class="section">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="section-label">Why Trove</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        One unified telemetry layer, four ways it pays off
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Because every harness flows through one local collector and one normalized schema, Trove
        gives teams a single pane of glass, finance a true cost comparison, and security a
        localhost-only, reversible footprint. All of it open source.
      </p>
    </div>

    <div class="space-y-24">
      {
        pillars.map((pillar, idx) => (
          <div
            class="grid items-center gap-10 lg:grid-cols-2"
            class:list={[{ 'lg:[&>*:first-child]:order-2': idx % 2 === 1 }]}
          >
            {/* Copy column */}
            <div>
              <div class="flex items-center gap-3">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-tile bg-brand/12 text-brand ring-1 ring-brand/20">
                  <Icon name={pillar.icon} size={22} />
                </span>
                <p class="section-label">{pillar.eyebrow}</p>
              </div>
              <h3 class="mt-5 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                {pillar.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-muted">{pillar.intro}</p>

              <ul class="mt-7 space-y-5">
                {pillar.subFeatures.map((sf) => (
                  <li class="flex gap-4">
                    <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-foreground/5 text-brand ring-1 ring-border-subtle/10">
                      <Icon name={sf.icon} size={18} />
                    </span>
                    <div>
                      <p class="text-sm font-semibold text-foreground">{sf.title}</p>
                      <p class="text-[13px] font-medium text-brand/90">{sf.hook}</p>
                      <p class="mt-1 text-sm leading-relaxed text-muted">{sf.description}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            {/* Media column — an autoplaying clip per entry, or a poster
                placeholder with a "coming soon" affordance until one lands. */}
            <div class="grid gap-4 sm:grid-cols-2">
              {pillar.clips.map((clip) => (
                <figure class="glass-card group relative overflow-hidden">
                  <div class="relative aspect-video w-full overflow-hidden bg-[#0f1413]">
                    {clip.hasVideo ? (
                      <video
                        class="absolute inset-0 h-full w-full object-cover"
                        poster={asset(clip.poster)}
                        aria-label={`${clip.title} demo`}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="auto"
                      >
                        <source src={asset(`${clip.slug}.webm`)} type="video/webm" />
                        <source src={asset(`${clip.slug}.mp4`)} type="video/mp4" />
                      </video>
                    ) : (
                      <Fragment>
                        <img
                          src={asset(clip.poster)}
                          alt={`${clip.title} preview`}
                          loading="lazy"
                          decoding="async"
                          class="absolute inset-0 h-full w-full object-cover"
                        />
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute inset-0 opacity-50"
                          style="background: radial-gradient(60% 60% at 50% 0%, rgba(45,191,184,0.20), transparent 70%);"
                        />
                        <span class="pointer-events-none absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-1.5 rounded-full bg-white/12 px-3 py-1.5 text-xs font-semibold text-white ring-1 ring-white/25 backdrop-blur-sm">
                          <Icon name="check" size={14} class="opacity-0" />
                          Demo coming soon
                        </span>
                      </Fragment>
                    )}
                  </div>
                  <figcaption class="px-4 py-3 text-sm font-semibold text-foreground">
                    {clip.title}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
