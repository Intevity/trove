---
// Site footer: Intevity attribution, copyright, and the canonical links (repo,
// docs, releases, license, issues). Docs link is resolved against BASE_URL so it
// works under the /trove GitHub Pages base path. External links go to the repo.

const base = import.meta.env.BASE_URL;
// Astro's BASE_URL carries a trailing slash; join without doubling it.
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const repo = 'https://github.com/Intevity/trove';

const links = [
  { label: 'Star on GitHub', href: repo, external: true },
  { label: 'Docs', href: asset('docs/'), external: false },
  { label: 'Releases', href: `${repo}/releases`, external: true },
  { label: 'License', href: `${repo}/blob/main/LICENSE`, external: true },
  { label: 'Report an issue', href: `${repo}/issues`, external: true },
];
---

<footer class="border-t border-border-subtle/10">
  <div class="section py-12">
    <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <div class="flex items-center gap-2">
        <img src={asset('trove-logo.svg')} alt="" width="28" height="28" class="h-7 w-7 object-contain" />
        <span class="text-base font-semibold text-foreground">Trove</span>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="text-sm font-medium text-muted transition-colors hover:text-foreground"
              {...l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-8 flex flex-col items-center gap-3 text-center text-sm text-muted">
      <a
        href="https://intevity.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-foreground/70 transition-colors hover:text-foreground"
      >
        <img
          src={asset('intevity-logo.png')}
          alt="Intevity"
          width="18"
          height="18"
          class="h-[18px] w-auto object-contain"
        />
        <span class="font-medium">Built by Intevity</span>
      </a>
      <p>Trove is open source, MIT licensed. &copy; 2026 Intevity.</p>
      <p class="max-w-xl text-xs text-foreground/40">
        All other product names, logos, and brands are the property of their respective
        owners and are used for identification only. Use does not imply endorsement.
      </p>
    </div>
  </div>
</footer>
