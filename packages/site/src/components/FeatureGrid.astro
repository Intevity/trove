---
// Capability grid: a quick-scan summary of what else Trove does beyond the
// guided carousel and the pillar narratives. Static, icon-led cards. Every icon
// name resolves through Icon.astro's path map; copy is grounded in the product
// facts (17 harnesses, 15 backends, Tier A schema, mappings editor, health
// pills, identity tagging, auto-update, reversible patches).
import Icon from './Icon.astro';

const items = [
  {
    icon: 'radar',
    title: '17 AI coding harnesses',
    body: 'Auto-detects Claude Code, Cursor, Antigravity CLI, Codex, OpenCode, Cline, and more the moment Trove launches.',
  },
  {
    icon: 'share',
    title: '15 backend integrations',
    body: 'SigNoz, Grafana Cloud, Honeycomb, Datadog, New Relic, Splunk, Dynatrace, Elastic, Sentry, plus Generic OTLP and a local passthrough.',
  },
  {
    icon: 'chart',
    title: 'Tier A metric schema',
    body: 'A normalized cross-harness shape (events, tokens, cost.usd, turn.duration, errors) makes every tool directly comparable.',
  },
  {
    icon: 'git-merge',
    title: 'Visual mappings editor',
    body: 'Map each native signal onto a Tier A metric with a live diff. Synthesis rules for native OTel, hook rules for watcher events.',
  },
  {
    icon: 'heart-pulse',
    title: 'Backend health pills',
    body: 'A green / amber / red / gray pill per platform, driven by the collector scrape metrics, so a dropping exporter shows immediately.',
  },
  {
    icon: 'toggle',
    title: 'Per-harness toggles',
    body: 'Enable or disable telemetry per tool from the Harnesses tab. Each toggle patches the config and flips the row the instant OTLP flows.',
  },
  {
    icon: 'users',
    title: 'Identity tagging',
    body: 'Tag every signal with user.name and user.email resource attributes so usage and cost roll up cleanly by person across the team.',
  },
  {
    icon: 'rotate-ccw',
    title: 'Reversible patches',
    body: 'Every config change is a sentinel-bracketed managed region you can diff, audit, and revert byte-for-byte in one click.',
  },
  {
    icon: 'download',
    title: 'Built-in auto-update',
    body: 'Signed releases update themselves from GitHub Releases. State lives in a single versioned state.json so upgrades stay clean.',
  },
];
---

<section id="features" class="section">
  <div class="mx-auto mb-14 max-w-2xl text-center">
    <p class="section-label">Everything in one tray</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      The whole pipeline, on your machine
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted">
      Trove detects your tools, patches them to emit OpenTelemetry, normalizes the signals through a
      bundled collector, and forwards one unified stream to the backend you choose.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((it) => (
        <div class="glass-card p-6 transition-transform hover:-translate-y-0.5">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-tile bg-brand/12 text-brand ring-1 ring-brand/20">
            <Icon name={it.icon} size={22} />
          </span>
          <h3 class="mt-4 text-base font-semibold text-foreground">{it.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{it.body}</p>
        </div>
      ))
    }
  </div>
</section>
